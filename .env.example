# Google Cloud web OAuth client ID. No client secret is used by this PWA.
VITE_GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# Browser API key restricted to your deployed origins and to Google Picker API
# plus Google Drive API.
VITE_GOOGLE_API_KEY=replace-with-browser-api-key

# Numeric Google Cloud project number used by Picker (recommended).
VITE_GOOGLE_APP_ID=000000000000

# "files" (default): narrow drive.file scope; select all site files explicitly.
# "folder": recursive folder import via restricted read-only Drive scope.
VITE_GOOGLE_DRIVE_MODE=files
